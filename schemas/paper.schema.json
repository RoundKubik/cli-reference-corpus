{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "NAssim paper command record with additional information and related topics (v3)",
  "required": [
    "CLIs",
    "FuncDef",
    "ParentViews",
    "ParaDef",
    "Examples",
    "UsageGuidelines",
    "related_topics",
    "ExtraInfo"
  ],
  "properties": {
    "CLIs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "FuncDef": {
      "type": "string"
    },
    "ParentViews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ParaDef": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "Paras",
          "Info"
        ],
        "properties": {
          "Paras": {
            "type": "string"
          },
          "Info": {
            "type": "string"
          }
        }
      }
    },
    "Examples": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "UsageGuidelines": {
      "type": "string",
      "description": "Usage scenarios, prerequisites, configuration impact and precautions from the manual."
    },
    "related_topics": {
      "type": "array",
      "description": "Explicit related sections and named command references. Target sections are exact title/alias matches in the PDF outline; empty means unresolved.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description",
          "source_section",
          "target_sections"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "source_section": {
            "type": "string",
            "minLength": 1
          },
          "target_sections": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "target_files": {
            "type": "array",
            "uniqueItems": true,
            "description": "JSON filenames relative to cmd_corpus, only for targets present in this export.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reference_kind": {
            "type": "string",
            "enum": [
              "documented_reference",
              "example_command",
              "parameter_topic"
            ]
          }
        }
      }
    },
    "ExtraInfo": {
      "type": "string"
    },
    "syntax_issues": {
      "type": "array",
      "description": "Non-fatal extraction/template-format diagnostics, not device CLI validation.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cli_index",
          "cli",
          "code",
          "message"
        ],
        "properties": {
          "cli_index": {
            "type": "integer",
            "minimum": 0
          },
          "cli": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
